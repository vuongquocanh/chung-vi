rules_version = '2';

// Luật bảo mật Firestore cho Chung Ví.
// Dán toàn bộ file này vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(db)/documents/households/$(hid)).data.members;
    }

    // Hồ sơ người dùng: chỉ chính chủ
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Mã mời: ai đăng nhập cũng tra được MỘT mã cụ thể (không liệt kê được danh sách)
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in getAfter(/databases/$(db)/documents/households/$(request.resource.data.hid)).data.members;
      allow delete: if signedIn() && isMember(resource.data.hid);
    }

    match /households/{hid} {
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.owner == request.auth.uid;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // chỉ chủ sổ (người tạo) được xóa sổ
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
      allow update: if signedIn() && (
        // chủ sổ: sửa mọi thứ, trừ chuyển quyền chủ sổ
        (request.auth.uid == resource.data.owner
          && request.resource.data.owner == resource.data.owner)
        // thành viên: sửa dữ liệu chi tiêu, KHÔNG đụng tới thông tin quản trị của sổ
        || (request.auth.uid in resource.data.members
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['owner', 'ownerEmail', 'members', 'inviteCode', 'createdAt']))
        // người có mã mời chỉ được tự thêm CHÍNH MÌNH vào members (tối đa 4 người)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && resource.data.members.size() < 4)
      );

      // Giao dịch của sổ
      match /tx/{txId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
